---
import "../styles/global.css";
import SiteFooter from "@bowen-hub/ui/astro/SiteFooter";
import SiteHeader from "@bowen-hub/ui/astro/SiteHeader";

interface Props {
  title: string;
  description: string;
  date?: string;
}
const { title, description, date } = Astro.props;
const links = [
  { label: "驾驶舱", href: "/" },
  { label: "行业与涨停", href: "/industries/" },
  { label: "方向与 ETF", href: "/directions/" },
  { label: "演化与事件", href: "/evolution/" },
  { label: "验证中心", href: "/validation/" },
  { label: "周报", href: "/weekly/" },
  { label: "方法与口径", href: "/methods/" },
  { label: "历史", href: "/archive/" },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="zh-CN" data-product="markets"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} · A 股观测台</title><meta name="description" content={description}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head><body><a class="sr-only" href="#content">跳到正文</a><SiteHeader name="A 股观测台" links={links}/><main id="content" class="container stack"><slot/></main><SiteFooter sources="TuShare" updatedAt={date} disclaimer="研究辅助，不构成投资建议"/></body></html>
