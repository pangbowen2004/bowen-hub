---
import DayOverview from "../components/DayOverview.astro";
import { hypotheses, indexBars } from "../components/data";
import IndexChart from "../components/IndexChart.astro";
import MarketPage from "../components/MarketPage.astro";
import RankingPreview from "../components/RankingPreview.astro";
import ValidationView from "../components/ValidationView.astro";
import { getDay } from "../lib/data";

const day = await getDay();
const bars = await indexBars(day.date);
const todays = (await hypotheses()).filter(
  (row) =>
    day.validation?.createdToday.includes(row.id) || day.validation?.settledToday.includes(row.id),
);
---
<MarketPage title="驾驶舱" lead="先看结构，再沿着证据验证。" day={day}><DayOverview day={day}/><RankingPreview day={day}/><IndexChart day={day} bars={bars}/><ValidationView day={day} hypotheses={todays}/><nav aria-label="继续观察"><a href="/directions/">方向与ETF →</a> · <a href="/industries/">行业与涨停 →</a> · <a href="/validation/">验证中心 →</a></nav></MarketPage>
