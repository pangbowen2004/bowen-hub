---
import MarketPage from "../../components/MarketPage.astro";
import WeeklyView from "../../components/WeeklyView.astro";
import { getDay, getWeekly, listWeeklies } from "../../lib/data";
export async function getStaticPaths() {
  return (await listWeeklies()).map((row) => ({ params: { date: row.date } }));
}
const date = Astro.params.date!;
const report = await getWeekly(date);
const day = await getDay(date);
---
<MarketPage title="周报详情" lead={report.sentence} day={day}><WeeklyView report={report}/></MarketPage>
