---
import PaperCards from "../../components/PaperCards.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPaper, getStudyCatalog } from "../../lib/data";
export async function getStaticPaths() {
  return (await getStudyCatalog()).spaces.map((space) => ({ params: { space: space.id } }));
}
const catalog = await getStudyCatalog();
const space = catalog.spaces.find((s) => s.id === Astro.params.space)!;
const papers = catalog.papers.filter(
  (p) => p.visibility === "public" && p.spaces.includes(space.id),
);
const details = await Promise.all(papers.map((p) => getPaper(p.id)));
---
<BaseLayout title={space.label} description={space.description}>
<header class="library-heading"><div><p class="paper-overline">RESEARCH SPACE / 研究空间</p><h1>{space.label}</h1><p class="space-description">{space.description}</p></div><p><strong>{papers.length.toString().padStart(2,'0')}</strong><span>篇可读论文</span></p></header>
<div class="library-layout"><aside class="library-spaces"><p class="paper-overline">研究空间</p><a href="/library/">全部论文<span>{catalog.papers.length}</span></a>{catalog.spaces.map(s=><a href={`/spaces/${s.id}/`} aria-current={s.id===space.id?'page':undefined}>{s.label}<span>{catalog.papers.filter(p=>p.spaces.includes(s.id)).length}</span></a>)}<a class="library-universe" href="/">进入知识宇宙 ↗</a></aside><section><PaperCards papers={papers} details={details} spaceLabels={Object.fromEntries(catalog.spaces.map(s=>[s.id,s.label]))}/>{papers.length===0&&<p>这个空间尚无公开论文。</p>}</section></div>
</BaseLayout>
