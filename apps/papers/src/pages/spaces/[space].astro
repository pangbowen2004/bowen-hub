---
import PaperCards from "../../components/PaperCards.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCatalog, getPaper } from "../../lib/data";
export async function getStaticPaths() {
  return (await getCatalog()).spaces.map((space) => ({ params: { space: space.id } }));
}
const catalog = await getCatalog();
const space = catalog.spaces.find((s) => s.id === Astro.params.space)!;
const papers = catalog.papers.filter(
  (p) => p.visibility === "public" && p.spaces.includes(space.id),
);
const details = await Promise.all(papers.map((p) => getPaper(p.id)));
---
<BaseLayout title={space.label} description={space.description}><header class="stack"><p class="eyebrow">研究空间</p><h1 class="editorial-title">{space.label}</h1><p>{space.description}</p><p class="muted">{papers.length} 篇公开论文</p></header><PaperCards papers={papers} details={details} spaceLabels={Object.fromEntries(catalog.spaces.map(s=>[s.id,s.label]))}/>{papers.length===0&&<p>这个空间尚无公开论文。</p>}</BaseLayout>
