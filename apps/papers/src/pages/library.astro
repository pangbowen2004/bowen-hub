---
import PaperCards from "../components/PaperCards.astro";
import TopicNavigation from "../components/TopicNavigation.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPaper, getSearchIndex, getStudyCatalog } from "../lib/data";
import { getReadingTaxonomy } from "../lib/topics";

const catalog = await getStudyCatalog();
const searchIndex = await getSearchIndex();
const papers = catalog.papers.filter((p) => p.visibility === "public");
const details = await Promise.all(papers.map((p) => getPaper(p.id)));
const taxonomy = getReadingTaxonomy(papers.map((paper) => paper.id));
---
<BaseLayout title="论文库" description="查找全部可读论文、中文导读与原文证据">
<header class="library-heading"><div><p class="paper-overline">COLLECTION / RESEARCH PAPERS</p><h1>论文库</h1></div><p><strong>{papers.length.toString().padStart(2,'0')}</strong><span>篇可读论文</span></p></header>
<div class="library-layout">
<TopicNavigation taxonomy={taxonomy}/>
<section class="library-collection">
<form class="paper-filters" role="search" aria-label="查找论文" onsubmit="return false">
<label class="library-search"><svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="5.5" stroke="currentColor"/><path d="m12 12 5 5" stroke="currentColor"/></svg><input type="search" id="paper-search" aria-label="搜索论文" placeholder="标题、作者、概念…"/></label>
<div class="library-refine"><label><span class="sr-only">研究主题</span><select id="space-filter"><option value="">全部主题</option>{taxonomy.topics.filter(topic=>topic.parentId===null).map(root=><optgroup label={root.label}><option value={root.id}>{root.label} · 全部</option>{taxonomy.topics.filter(topic=>topic.parentId===root.id).map(topic=><option value={topic.id}>{topic.label}</option>)}</optgroup>)}</select></label><label><span class="sr-only">年份</span><select id="year-filter"><option value="">全部年份</option>{[...new Set(papers.map(p=>p.year).filter(Boolean))].sort((a,b)=>Number(b)-Number(a)).map(year=><option value={year}>{year}</option>)}</select></label><label><span class="sr-only">排序</span><select id="paper-sort"><option value="recent">最近更新</option><option value="year">发表年份</option></select></label><details><summary>更多筛选</summary><div><label>论文类型<select id="kind-filter"><option value="">全部类型</option>{[...new Set(papers.map(p=>p.paperKind).filter(Boolean))].map(kind=><option value={kind}>{{empirical:'实证研究',theory:'理论研究',survey:'综述',system:'系统论文'}[kind!]}</option>)}</select></label><label>阅读深度<select id="depth-filter"><option value="">全部深度</option>{['R0','R1','R2','R3'].map(depth=><option>{depth}</option>)}</select></label></div></details></div>
</form>
<p id="result-count" class="library-result-count" role="status">{papers.length} 篇论文</p><div id="library-method" hidden><span></span><button type="button">清除标签 ×</button></div><PaperCards papers={papers} details={details} searchIndex={searchIndex} taxonomy={taxonomy}/><p id="empty-results" hidden>没有匹配的论文，请调整搜索或筛选。</p>
</section></div>
</BaseLayout>
<script>
import {paperSearch,type PaperSearchDocument} from '../components/search';
const cards=[...document.querySelectorAll<HTMLElement>('[data-paper-card]')];
const value=(id:string)=>(document.getElementById(id) as HTMLInputElement)?.value??'';
const search=paperSearch(cards.map(card=>JSON.parse(card.dataset.searchDocument??'{}') as PaperSearchDocument));
const params=new URLSearchParams(location.search);
let method=params.get('tag')??'';
const topicFilter=document.getElementById('space-filter') as HTMLSelectElement;
if([...topicFilter.options].some(option=>option.value===params.get('topic')))topicFilter.value=params.get('topic')??'';
function update(){const matching=search(value('paper-search'));let count=0;for(const card of cards){card.hidden=!(matching.has(card.dataset.id??'')&&(!value('space-filter')||card.dataset.topic?.split(' ').includes(value('space-filter')))&&(!method||(JSON.parse(card.dataset.methods??'[]') as string[]).includes(method))&&(!value('year-filter')||card.dataset.year===value('year-filter'))&&(!value('kind-filter')||card.dataset.kind===value('kind-filter'))&&(!value('depth-filter')||card.dataset.depth===value('depth-filter')));if(!card.hidden)count++;}cards.sort((a,b)=>value('paper-sort')==='year'?Number(b.dataset.year)-Number(a.dataset.year):String(b.dataset.updated).localeCompare(String(a.dataset.updated))).forEach(card=>document.getElementById('paper-list')?.append(card));document.getElementById('result-count')!.textContent=`${count} 篇论文`;document.getElementById('empty-results')!.hidden=count>0;document.querySelectorAll<HTMLElement>('[data-topic-filter]').forEach(link=>{if(link.dataset.topicFilter===value('space-filter'))link.setAttribute('aria-current','page');else link.removeAttribute('aria-current');});const methodBar=document.getElementById('library-method')!;methodBar.hidden=!method;methodBar.querySelector('span')!.textContent=`方法标签 · ${method}`;}
document.querySelector('#library-method button')?.addEventListener('click',()=>{method='';update();});
document.querySelector('.paper-filters')?.addEventListener('input',update);update();
</script>
