---
import { Universe3D } from "@bowen-hub/ui/react/Universe3D";
import { publicGraph } from "../components/paper";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCatalog, getGraph } from "../lib/data";

const data = publicGraph(await getGraph(), (await getCatalog()).papers);
---
<BaseLayout title="论文宇宙" description="在三维空间探索公开论文"><header class="stack"><p class="eyebrow">空间中的阅读线索</p><h1 class="editorial-title">论文宇宙</h1><p>把论文、概念与研究空间放在同一张地图上。</p></header><Universe3D data={data} client:visible/></BaseLayout>
