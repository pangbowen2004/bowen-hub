---
import { Universe3D } from "@bowen-hub/ui/react/Universe3D";
import { publicGraph } from "../components/paper";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCatalog, getGraph } from "../lib/data";

const catalog = await getCatalog();
const data = publicGraph(await getGraph(), catalog.papers);
---
<BaseLayout title="知识宇宙" description="在研究空间与概念之间找到公开论文"><Universe3D data={data} catalog={{...catalog,papers:catalog.papers.filter(p=>p.visibility==='public')}} client:load/></BaseLayout>
