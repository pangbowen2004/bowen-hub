{
  "name": "@bowen-hub/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "db:migrate:local": "wrangler d1 migrations apply bowen-hub --local",
    "db:migrate:remote": "wrangler d1 migrations apply bowen-hub --remote",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:contract": "node scripts/test-contract.ts",
    "db:generate": "drizzle-kit generate --config scripts/drizzle.config.ts",
    "auth:generate": "auth generate --config scripts/auth.config.ts --adapter drizzle --dialect sqlite --output src/db/schema/auth.ts --yes"
  },
  "dependencies": {
    "@bowen-hub/contracts": "workspace:*",
    "hono": "4.13.12",
    "drizzle-orm": "0.45.3",
    "better-auth": "1.7.6",
    "@better-auth/passkey": "1.7.6",
    "@better-auth/mcp": "1.7.6",
    "zod": "4.6.5",
    "@bowen-hub/ai": "workspace:*",
    "ai": "6.0.280"
  },
  "devDependencies": {
    "@bowen-hub/config": "workspace:*",
    "@cloudflare/vitest-plugin": "1.3.4",
    "@cloudflare/workers-types": "5.20260930.2",
    "@types/node": "catalog:",
    "auth": "1.7.6",
    "drizzle-kit": "0.31.11",
    "typescript": "catalog:",
    "vitest": "4.1.11",
    "wrangler": "4.145.0",
    "yaml": "2.9.1"
  }
}
