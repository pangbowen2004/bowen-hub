---
interface Props { caption: string; columns: { label: string; numeric?: boolean }[]; rows: (string | number | null)[][]; }
const { caption, columns, rows } = Astro.props;
---
<div class="table-wrap"><table><caption>{caption}</caption><thead><tr>{columns.map(column => <th scope="col" class:list={[column.numeric && "number"]}>{column.label}</th>)}</tr></thead><tbody>{rows.map(row => <tr>{row.map((value,index) => <td class:list={[columns[index]?.numeric && "number"]}>{value ?? "—"}</td>)}</tr>)}</tbody></table></div>
