---
import type { PaperClaim } from "@bowen-hub/contracts";

interface Props {
  claims?: PaperClaim[];
  inferred?: boolean;
  label?: string;
}
const { claims = [], inferred = false, label = "原文证据" } = Astro.props;
const id = `evidence-${crypto.randomUUID()}`;
---
{(claims.length > 0 || inferred) && <span class="evidence-mark">
  <button type="button" popovertarget={id} aria-controls={id}>{inferred ? "解释性推断" : label}<span aria-hidden="true"> ↗</span></button>
  <div id={id} popover="auto" class="evidence-popover" role="dialog" aria-label="原文证据与解释边界">
    <button type="button" class="close" popovertarget={id} popovertargetaction="hide" aria-label="关闭证据">关闭 ×</button>
    {inferred && <p>解释性推断，不能当作论文直接支持的主张。</p>}
    {claims.map(claim => <section><strong>{claim.claim}</strong>
      {claim.metric && <p>指标：{claim.metric}</p>}{claim.condition && <p>条件：{claim.condition}</p>}
      {(claim.anchor || claim.pdfPage) && <p class="muted">{claim.anchor}{claim.pdfPage && ` · PDF p.${claim.pdfPage}`}</p>}
      {claim.sourceExcerpt && <blockquote>{claim.sourceExcerpt}</blockquote>}
      {claim.interpretationBoundary && <p>解释边界：{claim.interpretationBoundary}</p>}
    </section>)}
  </div>
</span>}
<style>
.evidence-mark { display:inline-block; margin:.5rem 0 1rem; font-size:.875rem; }
button { color:var(--accent); cursor:pointer; min-height:44px; border:0; background:transparent; padding:.5rem; font:inherit; }
.evidence-popover { color:var(--text); padding:1.5rem; border:1px solid var(--border); background:var(--bg); box-shadow:0 12px 40px #0002; width:min(600px,calc(100vw - 32px)); max-height:calc(100dvh - 48px); overflow:auto; line-height:1.85; }
.evidence-popover::backdrop{background:#0002}.close{display:block;margin-left:auto}
section+section { border-top:1px solid var(--border); margin-top:1rem; padding-top:1rem; }
blockquote { margin:1rem 0; border-left:2px solid var(--accent); padding-left:1rem; }
</style>
