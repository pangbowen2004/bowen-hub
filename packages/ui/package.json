    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "astro": "6.4.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "storybook": "10.6.1",
    "@storybook/builder-vite": "10.6.1",
    "@storybook-astro/framework": "1.12.0",
    "@storybook/react": "10.6.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "30.1.1",
