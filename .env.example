# 复制为 .env 后填写。.env 不入库；值不要打印到终端或日志。
# 放在哪（本地 / GitHub Actions / Worker）见 docs/12 第 4 节。导入 GitHub：gh secret set -f .env

# —— AI（经 Cloudflare AI Gateway）——
OPENAI_API_KEY=                 # 与老 Daily News 的变量名相同，可直接复制
AI_GATEWAY_ID=bowen-hub

# —— Cloudflare ——
CLOUDFLARE_ACCOUNT_ID=4e61d97f57a5b1c96c971b70115ad8c4
CLOUDFLARE_API_TOKEN=           # 权限见 docs/07 第 2 节

# —— bowen-hub 自己的 API ——
HUB_API_URL=                    # https://bowen-hub-api.<账户子域>.workers.dev（T06 部署后填）；本地开发用 http://localhost:8787
HUB_SERVICE_TOKEN=              # 计算任务的服务令牌：openssl rand -hex 32
# 以下两项只放 Worker 密钥（wrangler secret put），本地和 GitHub 不需要：
#   HUB_BOOTSTRAP_TOKEN   第一次注册通行密钥用，注册后删除
#   BETTER_AUTH_SECRET    会话签名：openssl rand -hex 32

# —— GitHub ——
GH_AUTOMATION_TOKEN=            # 细粒度令牌：bowen-hub 与 bowen-hub-data 的 Contents 读写（docs/07 第 2 节）

# —— A 股 ——
TUSHARE_TOKEN=

# —— 美股（都是已有账号或免费 key）——
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
TIINGO_API_KEY=
FINNHUB_API_KEY=                # finnhub.io 免费注册
FRED_API_KEY=                   # fred.stlouisfed.org 免费申请
SEC_USER_AGENT=                 # 例："bowen-hub 你的邮箱"（SEC 要求带联系方式）

# —— 邮件（变量名与老 Daily News 完全相同，可直接复制值）——
EMAIL_FROM=
EMAIL_TO=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# —— 老项目位置（只在迁移时本地使用；不需要放进 GitHub）——
LEGACY_NEWS_DIR="/Users/pangbowen/Desktop/Daily News"
LEGACY_MARKET_DIR="/Users/pangbowen/Documents/量化/market-observatory"
LEGACY_PAPERS_DIR="/Users/pangbowen/Documents/ChatGPT/科研"
