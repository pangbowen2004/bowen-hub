        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "return20d": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "moneyflowProxyCny": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "moneyflowCoverage": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "minimum": 0,
      "maximum": 1,
