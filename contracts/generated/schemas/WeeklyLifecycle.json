{
  "$comment": "由 contracts 生成，勿手改（mise run gen）",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WeeklyLifecycle.json",
  "type": "object",
  "properties": {
    "persistentDirections": {
      "type": "array",
      "items": {
        "$ref": "MarketAppearance.json"
      }
    },
    "oscillatingDirections": {
      "type": "array",
      "items": {
        "$ref": "WeeklyOscillatingDirection.json"
      }
    },
    "latestWeakDirections": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "directionCoverageDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "有方向数据的交易日数量，页面显示覆盖 n/5。"
    },
    "windowDays": {
      "type": "number",
      "const": 5
    }
  },
  "required": [
    "persistentDirections",
    "oscillatingDirections",
    "latestWeakDirections",
    "directionCoverageDays",
    "windowDays"
  ],
  "description": "WeeklyLifecycle：市场观测台数据。"
}
